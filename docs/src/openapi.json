    "/api/auth": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /api/auth` — exchange the admin password for a session JWT.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bad credentials"
          }
        }
      },
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "`DELETE /api/auth` — logout. JWTs are stateless, so this is a client cue.",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Logout successful"
          }
        }
      }
    },
    "/api/auth/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "`GET /api/auth/callback` — complete the OAuth flow and redirect to the UI\nwith a session token in the URL fragment, or an error query on failure.",
        "operationId": "discord_callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to UI with token or error"
          }
        }
      }
    },
    "/api/auth/discord": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "`GET /api/auth/discord` — redirect the browser to Discord's OAuth consent.",
        "operationId": "discord_login",
        "responses": {
          "307": {
            "description": "Redirect to Discord"
          },
          "500": {
            "description": "Discord OAuth not configured"
          }
        }
      }
    },
