    "/api/mission": {
      "get": {
        "tags": [
          "dcs"
        ],
        "summary": "`GET /api/mission` → current mission + paused state (HookService) plus\nfilesystem-derived `serverInfo`, `queue`, and `uploadedMissions`.",
        "description": "Per-call gRPC failures fall back to `\"Unknown\"` / `false`, matching the\nsource's individual `.catch(...)` handling. A `serverSettings.lua` parse\nfailure yields `serverInfo: null` and an empty queue, as in the source.",
        "operationId": "mission_status",
        "responses": {
          "200": {
            "description": "Mission status details"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      },
      "post": {
        "tags": [
          "dcs"
        ],
        "summary": "`POST /api/mission` → mission control actions (HookService). Queue\nmutation (`add_to_queue` / `remove_from_queue`) is filesystem-backed and\nreturns `501` until Phase 5.",
        "operationId": "mission_action",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MissionBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Mission action successful"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    },
