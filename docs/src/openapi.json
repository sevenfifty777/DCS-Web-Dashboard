      "get": {
        "tags": [
          "lso"
        ],
        "operationId": "chart",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Pass row id from /api/lso/passes",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Final-approach trap sheet PNG",
            "content": {
              "image/png": {}
            }
          },
          "404": {
            "description": "Pass or PNG not found"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    },
