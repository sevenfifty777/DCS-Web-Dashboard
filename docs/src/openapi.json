    "/api/lso/passes": {
      "get": {
        "tags": [
          "lso"
        ],
        "operationId": "passes",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows to return (default 200, max 2000).",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          {
            "name": "since_id",
            "in": "query",
            "description": "Only return passes with an id greater than this (incremental polling).",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recorded passes, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LsoPassesResponse"
                }
              }
            }
          },
          "404": {
            "description": "LSO_DIR not configured or lso.db not created yet"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    },
